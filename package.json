{
  "name": "scnt-eg-website",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "node server/tests/runner.js",
    "test:jest": "jest --config server/jest.config.js --runInBand",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "heroku-postbuild": "npm run build -w client"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "babel-jest": "^30.4.1",
    "concurrently": "^9.1.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  }
}
